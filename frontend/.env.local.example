NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Required for the Hotel Detail page's map (components/HotelMap.tsx).
# Get a free key at https://map.longdo.com/ (Longdo Map, a Thailand-focused
# map provider - no billing account required, unlike Google Maps). The
# JS library is loaded directly from https://api.longdo.com/map/, so there
# is no npm package to install.
NEXT_PUBLIC_LONGDO_MAP_KEY=
